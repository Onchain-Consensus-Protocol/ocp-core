{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/(?:degen|market)\\.html$",
      "has": [
        {
          "type": "query",
          "key": "market",
          "value": "0x[0-9a-fA-F]{40}"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:Twitterbot|facebookexternalhit|LinkedInBot|Discordbot|TelegramBot|Slackbot).*"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:Twitterbot|facebookexternalhit|LinkedInBot|Slackbot|Discordbot|TelegramBot|WhatsApp).*"
        }
      ],
      "dest": "/api/topic-share"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "market.ocp-protocol.org"
        }
      ],
      "dest": "/market.html"
    },
    {
      "handle": "filesystem"
    }
  ],
  "functions": {
    "api/paper.ts": {
      "includeFiles": "server/paper/schema.sql"
    },
    "api/market-share.ts": {
      "includeFiles": "{server/paper/schema.sql,public/logo.png,public/ocp-wordmark.svg}"
    },
    "api/chain-history.ts": {
      "maxDuration": 60
    }
  }
}
