{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "market.ocp-protocol.org"
        }
      ],
      "dest": "/explore.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
